{
  "dataset_name": "SC-CaTH Synthetic Professional Network",
  "version": "1.0.0",
  "synthetic_only": true,
  "seed": 42,
  "time_window": {
    "start": "2023-01-01T00:00:00",
    "end": "2025-03-01T00:00:00",
    "t1": "2024-05-01T00:00:00",
    "t2": "2024-11-01T00:00:00",
    "split_rule": "train: timestamp <= t1; validation: t1 < timestamp <= t2; test: timestamp > t2"
  },
  "structural_null_fields": {
    "career_events.csv": [
      "end_time",
      "previous_seniority_level",
      "previous_occupation_id"
    ],
    "hyperedges.csv": [
      "sc_role",
      "sc_stage",
      "sc_path"
    ]
  },
  "files": {
    "users.csv": {
      "description": "Baseline professional profile as of the beginning of the observation window; not a final/current snapshot.",
      "primary_key": [
        "user_id"
      ],
      "fields": {
        "user_id": {
          "type": "string",
          "nullable": false,
          "description": "Unique synthetic user identifier U0001..."
        },
        "experience_years": {
          "type": "float",
          "nullable": true,
          "description": "Synthetic professional experience at baseline; 2% deliberately null."
        },
        "industry_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to industries.industry_id."
        },
        "function_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to functions.function_id."
        },
        "occupation_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to occupations.occupation_id."
        },
        "seniority_level": {
          "type": "integer",
          "nullable": false,
          "description": "Synthetic ordinal level 1..7."
        },
        "education_level": {
          "type": "string",
          "nullable": false,
          "description": "Synthetic category; unknown represents unrecorded information."
        },
        "field_of_study": {
          "type": "string",
          "nullable": false,
          "description": "Synthetic category; unknown represents unrecorded information."
        },
        "university_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to universities; V_UNKNOWN is a valid synthetic lookup row."
        },
        "company_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to companies; company at baseline."
        },
        "company_size": {
          "type": "string",
          "nullable": false,
          "description": "Baseline company-size category or unknown token."
        },
        "geographic_region_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to locations; synthetic region."
        },
        "supply_chain_role": {
          "type": "string",
          "nullable": false,
          "description": "One of seven abstract supply-chain roles."
        },
        "supply_chain_stage": {
          "type": "string",
          "nullable": false,
          "description": "Upstream, Midstream, or Downstream."
        },
        "supply_chain_path": {
          "type": "string",
          "nullable": false,
          "description": "Synthetic path category."
        },
        "profile_text": {
          "type": "string",
          "nullable": true,
          "description": "Synthetic baseline text built from tokens/IDs; 2% null."
        },
        "occupation_text": {
          "type": "string",
          "nullable": true,
          "description": "Synthetic occupation text; 2% null."
        },
        "skills_text": {
          "type": "string",
          "nullable": true,
          "description": "Baseline skill IDs separated by |; 2% null."
        },
        "is_cold": {
          "type": "boolean",
          "nullable": false,
          "description": "True when user has fewer than 5 user-user relation events at or before t1; split metadata, not a model feature."
        },
        "first_interaction_time": {
          "type": "timestamp",
          "nullable": true,
          "description": "First relation/interest-like timestamp over the full window; audit-only and future-aware, exclude as a model feature."
        },
        "pre_t1_interaction_count": {
          "type": "integer",
          "nullable": false,
          "description": "Count of user-user relation events at or before t1; used to verify cold-start membership."
        }
      },
      "foreign_keys": [
        {
          "field": "industry_id",
          "references_file": "industries.csv",
          "references_field": "industry_id"
        },
        {
          "field": "function_id",
          "references_file": "functions.csv",
          "references_field": "function_id"
        },
        {
          "field": "occupation_id",
          "references_file": "occupations.csv",
          "references_field": "occupation_id"
        },
        {
          "field": "university_id",
          "references_file": "universities.csv",
          "references_field": "university_id"
        },
        {
          "field": "company_id",
          "references_file": "companies.csv",
          "references_field": "company_id"
        },
        {
          "field": "geographic_region_id",
          "references_file": "locations.csv",
          "references_field": "geographic_region_id"
        }
      ]
    },
    "companies.csv": {
