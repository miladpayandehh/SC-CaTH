        "skills": {
          "type": "string",
          "nullable": false,
          "description": "Pipe-separated synthetic skill IDs."
        },
        "seniority_level": {
          "type": "integer",
          "nullable": false,
          "description": "Current level 1..7."
        },
        "previous_seniority_level": {
          "type": "integer",
          "nullable": true,
          "description": "Previous level; structurally null for first trajectory event."
        },
        "previous_occupation_id": {
          "type": "string",
          "nullable": true,
          "description": "Previous occupation; structurally null for first trajectory event."
        },
        "start_time": {
          "type": "timestamp",
          "nullable": false,
          "description": "Career-record/position start marker within the observation window."
        },
        "end_time": {
          "type": "timestamp",
          "nullable": true,
          "description": "Next career event timestamp, or null for final active position."
        },
        "duration_months": {
          "type": "integer",
          "nullable": false,
          "description": "Synthetic position tenure 6..60; final active tenure can include time before the observation window."
        },
        "delta_seniority": {
          "type": "integer",
          "nullable": false,
