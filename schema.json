          "type": "string",
          "nullable": false,
          "description": "FK to users."
        },
        "company_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to companies."
        },
        "industry_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to industries."
        },
        "function_id": {
          "type": "string",
          "nullable": false,
          "description": "FK to functions."
